<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Photo Gallery</title>
</head>
<body>

  <h2>Photo Gallery</h2>

  <% if (images && images.length > 0) { %>
    <% images.forEach(image => { %>
      <img src="img1.jpg" width="200">
    <% }) %>
  <% } else { %>
    <p>No images available</p>
  <% } %>

</body>
</html>
